{
  "name": "eslint-config-neo",
  "version": "0.15.0",
  "description": "Official Neo Financial ESLint configuration",
  "main": "index.js",
  "author": "Neo Financial Engineering <engineering@neofinancial.com>",
  "license": "MIT",
  "homepage": "https://github.com/neofinancial/eslint-config-neo",
  "repository": {
    "type": "git",
    "url": "https://github.com/neofinancial/eslint-config-neo.git"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=22.0.0"
  },
  "files": [
    "*.js"
  ],
  "scripts": {
    "format": "prettier --write \"**/*.{js,json,yaml,yml,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,yaml,yml,md}\"",
    "prepare": "husky",
    "precommit": "lint-staged"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@eslint/js": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^56.0.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript-eslint": "^8.59.1"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  }
}
